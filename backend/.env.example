# SenseForge Backend Environment Variables
# Connection string ke MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/?retryWrites=true&w=majority

# Daftar origin CORS yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
